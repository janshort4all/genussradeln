// Zusatz für Anstrengung „gemütlich“: Steigungen deutlich meiden.
// Die App schickt diesen Inhalt pro Anfrage als custom_model mit (wird an „genuss“ angehängt).
// Liegt hier als Referenz und für Tests (test-roundtrip.ps1 -Gemuetlich).
{
  "priority": [
    { "if": "average_slope >= 8 || average_slope <= -8", "multiply_by": "0.3" },
    { "else_if": "average_slope >= 5 || average_slope <= -5", "multiply_by": "0.6" }
  ]
}
