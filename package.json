{
	"name": "genuss-radeln",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:handy": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"icons": "node scripts/make-logo.mjs",
		"android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1",
		"test": "vitest run",
		"routing:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File routing/setup.ps1",
		"routing:start": "powershell -NoProfile -ExecutionPolicy Bypass -File routing/start.ps1",
		"routing:test": "node routing/test-roundtrip.mjs",
		"routing:karte": "node routing/show-map.mjs --oeffnen",
		"data": "node --max-old-space-size=8192 scripts/build-data.ts",
		"server": "node scripts/server.mjs"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
		"@lucide/svelte": "^1.51.0",
		"@osmix/pbf": "^0.0.10",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.1",
		"@vite-pwa/assets-generator": "^1.0.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"sharp": "^0.35.5",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@capacitor-community/background-geolocation": "^1.2.26",
		"@capacitor-community/keep-awake": "^8.0.1",
		"@capacitor-community/text-to-speech": "^8.0.2",
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.5.3",
		"@capacitor/filesystem": "^8.1.4",
		"@capacitor/geolocation": "^8.2.3",
		"@capacitor/share": "^8.0.3",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"maplibre-gl": "^6.11.2"
	}
}
