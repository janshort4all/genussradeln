		"icons": "node scripts/make-logo.mjs",
		"routing:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File routing/setup.ps1",
		"routing:start": "powershell -NoProfile -ExecutionPolicy Bypass -File routing/start.ps1",
		"routing:test": "node routing/test-roundtrip.mjs"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.51.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.1",
		"@vite-pwa/assets-generator": "^1.0.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"sharp": "^0.35.5",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
